@model List< _21_July_Assign.Models.Department>
<h2>Register Successfully</h2>
<h3>Welcome @TempData["emp"] of Department @TempData["dep"]</h3>
<h5>The Details for the departments are shown below</h5>

<table>
    <tr>
        <th>Dept_Name</th>
        <th>Dept_Head</th>
        <th>Contact</th>
        <th>Email</th>
    </tr>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Department_Name</td>
            <td>@item.Department_Head</td>
            <td>@item.Contact_No</td>
            <td>@item.Email</td>


        </tr>
}
