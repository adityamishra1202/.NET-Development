@model _22_July_Assign.Models.Automobile

<div class="text-center">
    <h1 class="display-4">Add Product</h1>
</div>

<form asp-controller="Home" asp-action="Index" method="post">

    <div>
        <label asp-for="Vehicle_Name"></label>
        <input asp-for="Vehicle_Name" class="form-control" />
        <span asp-validation-for="Vehicle_Name" style="color:red"></span>
    </div>

    <br />

    <div>
        <label asp-for="Brand"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" style="color:red"></span>
    </div>

    <br />

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" style="color:red"></span>
    </div>

    <br />

    <div>
        <label asp-for="Model_Year"></label>
        <input asp-for="Model_Year" class="form-control" />
        <span asp-validation-for="Model_Year" style="color:red"></span>
    </div>
    <div>
        <label asp-for="FuelType"></label>
        <input asp-for="FuelType" class="form-control" />
        <span asp-validation-for="FuelType" style="color:red"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Save Product</button>

</form>
@if (ViewBag.Message != null)
{
    <h3 style="color:green">@ViewBag.Message</h3>
}

